# Scheduling front-desk-ai on a Linux server (2 of 2: the timer).
#
# sudo cp systemd.example.timer /etc/systemd/system/front-desk-ai.timer
# sudo systemctl daemon-reload
# sudo systemctl enable --now front-desk-ai.timer
# systemctl list-timers | grep front-desk-ai

[Unit]
Description=Run front-desk-ai every 15 minutes

[Timer]
OnCalendar=*:0/15

# Catch up after a reboot or a maintenance window instead of skipping.
Persistent=true

# Stagger the start so several agents on one box do not all wake together.
RandomizedDelaySec=60

Unit=front-desk-ai.service

[Install]
WantedBy=timers.target
