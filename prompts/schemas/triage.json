{
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["question", "room_booking", "table_booking", "spa_booking",
               "experience_inquiry", "guest_fact", "modification",
               "thank_you", "other"]
    },
    "lane": { "type": "string", "enum": ["front_desk", "specialist"] },
    "language": { "type": "string", "minLength": 2, "maxLength": 2 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "booking": {
      "type": ["object", "null"],
      "properties": {
        "room_type": { "type": ["string", "null"] },
        "checkin": { "type": ["string", "null"] },
        "checkout": { "type": ["string", "null"] },
        "pax": { "type": ["integer", "null"] },
        "party_size": { "type": ["integer", "null"] },
        "date": { "type": ["string", "null"] },
        "time": { "type": ["string", "null"] },
        "treatment": { "type": ["string", "null"] },
        "session_slug": { "type": ["string", "null"] },
        "occasion": { "type": ["string", "null"] },
        "reservation_ref": { "type": ["string", "null"] },
        "dietary_notes": { "type": ["string", "null"] },
        "special_requests": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "guest_fact": {
      "type": ["object", "null"],
      "properties": {
        "note": { "type": "string", "maxLength": 300 },
        "department": {
          "type": "string",
          "enum": ["fnb", "housekeeping", "maintenance", "guest_relations"]
        },
        "reservation_ref": { "type": ["string", "null"] }
      },
      "required": ["note", "department"],
      "additionalProperties": false
    },
    "missing_info": {
      "type": "array",
      "items": { "type": "string" }
    },
    "escalation": {
      "type": ["object", "null"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["refund", "complaint", "payment", "safety",
                   "policy_exception", "missing_info", "vip"]
        },
        "reason": { "type": "string", "maxLength": 300 }
      },
      "required": ["category", "reason"],
      "additionalProperties": false
    },
    "reason": { "type": "string", "maxLength": 300 }
  },
  "required": ["intent", "lane", "language", "confidence"],
  "additionalProperties": false
}
